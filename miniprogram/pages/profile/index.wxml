<view class="container page-profile">
  <view class="top-left-home" bindtap="goToHome">
    <text class="home-icon">⌂</text>
  </view>
  <view class="profile-card card">
    <view class="row">
      <view>
        <view class="title">{{user.name}}</view>
        <view class="subtle">{{user.role === 'superadmin' ? '超级管理员' : user.role === 'admin' ? '管理员' : '操作工'}} · {{user.stationsDisplay || '未分配岗位'}}</view>
      </view>
      <text class="badge badge-info">{{user.role === 'superadmin' ? '超管' : user.role === 'admin' ? '管理' : '员工'}}</text>
    </view>

    <view class="switch-block">
      <text class="switch-label">切换演示身份</text>
      <picker mode="selector" range="{{employees}}" range-key="name" bindchange="switchUser">
        <view class="switch-picker">当前：{{user.name}}</view>
      </picker>
    </view>

    <!-- 大字模式：只放大工单详情页文字，方便年纪大的员工看清 -->
    <view class="switch-block elder-switch">
      <view>
        <text class="switch-label">大字模式</text>
        <view class="switch-tip">放大工单详情页的文字</view>
      </view>
      <switch checked="{{elderMode}}" bindchange="toggleElderMode" color="#0f766e" />
    </view>

    <!-- 超管专属：一键切换超管/员工视角 + 编辑岗位 -->
    <view wx:if="{{user.role === 'superadmin' || disguised}}" class="switch-block super-tools">
      <view class="super-tools-row">
        <button class="tool-btn {{disguised ? 'tool-btn-back' : ''}}" bindtap="toggleSuperIdentity">
          {{disguised ? '切回超管身份' : '切换员工视角'}}
        </button>
        <button wx:if="{{!disguised}}" class="tool-btn tool-btn-station" bindtap="openStationEditor">编辑岗位</button>
      </view>
    </view>

    <view class="profile-stats" wx:if="{{user.role === 'admin' || user.role === 'superadmin'}}">
      <view class="stat-item">
        <text class="stat-value">{{dashboard.pendingEmployees || 0}}</text>
        <text class="stat-label">待审批</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{dashboard.paused || 0}}</text>
        <text class="stat-label">暂停中</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{dashboard.overdue || 0}}</text>
        <text class="stat-label">逾期</text>
      </view>
    </view>

    <view class="profile-stats" wx:else>
      <view class="stat-item">
        <text class="stat-value">{{monthlyStats.totalRoots || 0}}</text>
        <text class="stat-label">本年完成</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{monthlyStats.currentMonthRoots || 0}}</text>
        <text class="stat-label">本月完成</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{dashboard.completed || 0}}</text>
        <text class="stat-label">已完成工单</text>
      </view>
    </view>

    <view class="monthly-summary card-mini">
      <view class="row">
        <view>
          <view class="mini-title">本年计件统计</view>
          <view class="subtle">当前月：{{monthlyStats.currentMonthRoots || 0}} 根</view>
        </view>
        <text class="mini-total">{{monthlyStats.totalRoots || 0}} 根</text>
      </view>
    </view>

    <view class="profile-actions">
      <button class="action-btn primary" bindtap="goScan">扫码进单</button>
      <button class="action-btn ghost" bindtap="goMyOrders">我的工单</button>
      <button class="action-btn ghost" bindtap="goOrders">查看工单</button>
    </view>

    <view wx:if="{{user.role === 'admin' || user.role === 'superadmin'}}" class="profile-actions">
      <button class="action-btn admin-btn" bindtap="goAdmin">进入管理中心</button>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">{{monthlyStats.year}} 月度根数</view>
    <view class="month-grid">
      <block wx:for="{{monthlyStats.monthlyRoots}}" wx:key="key">
        <view class="month-card">
          <text class="month-label">{{item.label}}</text>
          <text class="month-value">{{item.roots}} 根</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 配合根数（作为编程员/调字员参与 敦压/拉尾子/精车/铣方头/打字 的量） -->
  <view wx:if="{{monthlyStats.programmerTotalRoots > 0}}" class="section card">
    <view class="section-title">{{monthlyStats.year}} 配合根数</view>
    <view class="monthly-summary card-mini">
      <view class="row">
        <view>
          <view class="mini-title">本年配合</view>
          <view class="subtle">当前月：{{monthlyStats.programmerCurrentMonthRoots || 0}} 根</view>
        </view>
        <text class="mini-total">{{monthlyStats.programmerTotalRoots || 0}} 根</text>
      </view>
    </view>
    <view class="month-grid">
      <block wx:for="{{monthlyStats.programmerMonthlyRoots}}" wx:key="key">
        <view class="month-card">
          <text class="month-label">{{item.label}}</text>
          <text class="month-value">{{item.roots}} 根</text>
        </view>
      </block>
    </view>
    <view class="subtle">统计口径：作为编程员 / 调字员参与的敦压 / 拉尾子 / 精车 / 铣方头 / 打字工序根数</view>
  </view>

  <view class="section card">
    <view class="section-title">岗位绑定员工（{{employees.length}}人）</view>
    <block wx:for="{{employees}}" wx:key="id">
      <view class="employee-item">
        <view class="row">
          <text class="employee-name">{{item.name}}</text>
          <text class="badge badge-success">{{item.statusLabel || '已激活'}}</text>
        </view>
        <view class="subtle">{{item._stationDisplay || '未分配岗位'}} · {{item.roleLabel || '员工'}}</view>
      </view>
    </block>
  </view>

  <view class="section card">
    <view class="section-title">最近日志</view>
    <block wx:for="{{logs}}" wx:key="id">
      <view class="log-item">
        <view class="row">
          <text class="log-action">{{item.action}}</text>
          <text class="subtle">{{item.at}}</text>
        </view>
        <view class="subtle">{{item.target}} · {{item.operator}}</view>
      </view>
    </block>
  </view>

  <!-- 编辑岗位弹窗（仅超管）：选员工 → 勾选岗位 → 保存 -->
  <view wx:if="{{showStationModal}}" class="modal-mask" bindtap="closeStationModal">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-title">编辑员工岗位</view>
      <view class="modal-sub">当前编辑：{{editingStationsName}}</view>
      <scroll-view scroll-x class="emp-chips" enhanced show-scrollbar="{{false}}">
        <view class="emp-chips-inner">
          <view
            wx:for="{{stationEmpList}}"
            wx:key="id"
            class="emp-chip {{editingStationsId === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectStationEmp"
          >{{item.name}}</view>
        </view>
      </scroll-view>
      <view class="station-grid">
        <view
          wx:for="{{allStations}}"
          wx:key="station"
          class="station-cell {{item.checked ? 'checked' : ''}}"
          data-station="{{item.station}}"
          bindtap="toggleStationCheck"
        >{{item.name}}</view>
      </view>
      <view class="modal-actions">
        <button class="modal-btn ghost" bindtap="closeStationModal">取消</button>
        <button class="modal-btn primary" bindtap="saveStationEdit">保存</button>
      </view>
    </view>
  </view>

  <view class="privacy-footer">
    <text class="privacy-link" bindtap="openPrivacyContract">《隐私保护指引》</text>
  </view>
</view>
