.page-profile {
  padding-bottom: 40rpx;
}

.profile-card,
.section {
  padding: 28rpx;
}

.profile-card {
  background: linear-gradient(135deg, #0f172a 0%, #334155 100%);
  color: #ffffff;
}

.profile-card .title,
.profile-card .subtle {
  color: #ffffff;
}

.profile-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.card-mini {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
}

.mini-title {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
}

.mini-total {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 12rpx;
}

.month-card {
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.month-label {
  display: block;
  color: #64748b;
  font-size: 22rpx;
}

.month-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.switch-block {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
}

.switch-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.switch-picker {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 24rpx;
  color: #ffffff;
}

.stat-item {
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.profile-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.action-btn {
  flex: 1;
  border-radius: 18rpx;
  line-height: 2.4;
  font-size: 26rpx;
}

.action-btn.primary {
  background: #f59e0b;
  color: #ffffff;
}

.action-btn.ghost {
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.action-btn.admin-btn {
  background: #2563eb;
  color: #ffffff;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.employee-item,
.log-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.employee-item:first-child,
.log-item:first-child {
  border-top: none;
  padding-top: 0;
}

.employee-name,
.log-action {
  font-size: 26rpx;
  font-weight: 600;
}

.privacy-footer {
  text-align: center;
  padding: 30rpx 20rpx 60rpx;
}

.privacy-link {
  color: #94a3b8;
  font-size: 24rpx;
  text-decoration: underline;
}

@media (max-width: 720px) {
  .month-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
