

.page-home {
  padding-bottom: 40rpx;
}

.hero {
  padding: 32rpx;
  background: linear-gradient(135deg, #0f172a 0%, #164e63 55%, #0ea5a5 100%);
  color: #ffffff;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-pill {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 24rpx;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1 1 44%;
  font-size: 26rpx;
  border-radius: 18rpx;
  line-height: 2.4;
  border: none;
}

.action-btn.primary {
  background: #f59e0b;
  color: #ffffff;
}

.action-btn.ghost {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.metric {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 18rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border-left: 6rpx solid #e2e8f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05), 0 1rpx 3rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  position: relative;
  overflow: hidden;
}

.metric::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, transparent 60%, rgba(0, 0, 0, 0.012) 100%);
  pointer-events: none;
}

.metric:active {
  transform: scale(0.97);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.metric-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.metric-value {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.5rpx;
}

.metric-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}

.metric-arrow {
  font-size: 32rpx;
  color: #94a3b8;
  line-height: 1;
  flex-shrink: 0;
  margin-left: 8rpx;
  transition: transform 0.15s ease, color 0.15s ease;
}

.metric:active .metric-arrow {
  transform: translateX(3rpx);
  color: #94a3b8;
}

/* 加急 - 红色 */
.metric-urgent {
  border-left-color: #ef4444;
  background: linear-gradient(135deg, #fffafa 0%, #ffffff 100%);
}
.metric-urgent .metric-value { color: #dc2626; }
.metric-urgent:active { background: #fef2f2; }

/* 逾期 - 橙色 */
.metric-overdue {
  border-left-color: #f97316;
  background: linear-gradient(135deg, #fff7ed 0%, #ffffff 100%);
}
.metric-overdue .metric-value { color: #ea580c; }
.metric-overdue:active { background: #ffedd5; }

/* 暂停 - 琥珀 */
.metric-paused {
  border-left-color: #f59e0b;
  background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);
}
.metric-paused .metric-value { color: #d97706; }
.metric-paused:active { background: #fef3c7; }

/* 已完成 - 绿色 */
.metric-completed {
  border-left-color: #22c55e;
  background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
}
.metric-completed .metric-value { color: #16a34a; }
.metric-completed:active { background: #dcfce7; }

/* 生产中 - 青色 */
.metric-processing {
  border-left-color: #0ea5a9;
  background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%);
}
.metric-processing .metric-value { color: #0d9488; }
.metric-processing:active { background: #ccfbf1; }

/* 未开始 - 中性灰(待启动,没有进度) */
.metric-notstarted {
  border-left-color: #94a3b8;
}
.metric-notstarted .metric-value { color: #64748b; }
.metric-notstarted:active { background: #f1f5f9; }

.section {
  margin-top: 24rpx;
  padding: 24rpx;
}

.section-head {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.section-link {
  font-size: 24rpx;
  color: #0f766e;
}

.order-item,
.log-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.order-item.urgent {
  background: #fef2f2;
  border-radius: 12rpx;
  margin: 8rpx -24rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #dc2626;
}

.order-item:first-child,
.log-item:first-child {
  border-top: none;
  padding-top: 0;
}

.order-line {
  gap: 16rpx;
}

/* 工单号降为次要信息（小号浅色），让位给公司名称 */
.order-id {
  font-size: 24rpx;
  font-weight: 600;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 公司名称：员工找单的第一关键字，放大 + 品牌青色突出 */
.order-customer {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f766e;
}

/* 种类/尺寸/当前：加大字号便于快速扫读；数值用琥珀金加重（与主按钮同色，
   全卡片仅公司名青色 + 数值琥珀金两个强调色，克制且协调） */
.order-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.order-meta .meta-val {
  color: #d97706;
  font-weight: 700;
}

.log-action {
  font-size: 26rpx;
  font-weight: 600;
}

/* ===== 员工管理弹窗 ===== */
.emp-mask, .prod-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}

.emp-panel, .prod-panel {
  width: 92%; max-height: 85vh;
  background: #fff; border-radius: 24rpx;
  padding: 32rpx; box-sizing: border-box;
  overflow-y: auto;
}

.emp-header, .prod-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx;
}

.emp-title, .prod-title { font-size: 34rpx; font-weight: 700; color: #1e293b; }
.emp-close, .prod-close {
  font-size: 36rpx; color: #94a3b8;
  padding: 10rpx; line-height: 1;
}

/* Tab 切换 */
.emp-tabs {
  display: flex; gap: 12rpx; margin-bottom: 20rpx;
  background: #f1f5f9; border-radius: 14rpx; padding: 6rpx;
}

.emp-tab {
  flex: 1; text-align: center; padding: 16rpx 0;
  font-size: 26rpx; color: #64748b; border-radius: 10rpx;
  transition: all 0.2s;
}

.emp-tab.active {
  background: #fff; color: #0f766e; font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.emp-tab-content { min-height: 200rpx; }

/* 员工列表滚动区 */
.emp-list-scroll {
  max-height: 55vh;
}

/* 员工卡片 */
.emp-card {
  padding: 24rpx; border-radius: 16rpx;
  background: #f8fafc; border: 2rpx solid transparent;
  margin-bottom: 16rpx; transition: all 0.2s;
}

.emp-card.editing {
  background: #fff; border-color: #0d9488;
  box-shadow: 0 4rpx 16rpx rgba(13,148,136,0.15);
}

.emp-card-top {
  display: flex; justify-content: space-between; align-items: center;
}

.emp-card-info {
  display: flex; align-items: center; gap: 12rpx;
}

.emp-card-name {
  font-size: 30rpx; font-weight: 700; color: #1e293b;
}

.emp-card-role-badge {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 8rpx;
}
.badge-superadmin { background: #fef3c7; color: #b45309; }
.badge-admin { background: #dbeafe; color: #2563eb; }
.badge-worker { background: #f1f5f9; color: #475569; }
.badge-pending { background: #fee2e2; color: #dc2626; }

.emp-edit-btn {
  font-size: 24rpx; color: #0f766e; padding: 10rpx 20rpx;
  border: 2rpx solid #0f766e; border-radius: 10rpx;
}

/* 岗位标签展示 */
.emp-stations-display {
  display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx;
}

.emp-station-tag {
  font-size: 22rpx; padding: 8rpx 18rpx;
  background: #e0f2fe; color: #0369a1; border-radius: 8rpx;
}

/* 【UI】管理员标签：与工种标签明显区分，使用醒目的琥珀色实心样式 */
.emp-admin-tag {
  font-size: 22rpx; padding: 8rpx 18rpx;
  background: #f59e0b; color: #ffffff;
  border-radius: 8rpx; font-weight: 700;
}

.emp-stations-empty {
  font-size: 22rpx; color: #94a3b8; margin-top: 8rpx;
}

/* 岗位编辑器 */
.emp-stations-editor {
  margin-top: 16rpx; padding-top: 16rpx;
  border-top: 1rpx dashed #cbd5e1;
}

.emp-stations-tip {
  font-size: 24rpx; color: #64748b; margin-bottom: 14rpx;
}

.emp-checkbox-grid {
  display: flex; flex-wrap: wrap; gap: 12rpx;
}

.emp-check-item {
  display: flex; align-items: center; gap: 8rpx;
  padding: 12rpx 16rpx; border-radius: 10rpx;
  background: #f1f5f9; border: 2rpx solid transparent;
  transition: all 0.15s;
}

.emp-check-item.checked {
  background: #ecfeff; border-color: #06b6d4;
}

.emp-check-box {
  width: 32rpx; height: 32rpx; border-radius: 6rpx;
  border: 2rpx solid #94a3b8; display: flex;
  align-items: center; justify-content: center;
  font-size: 20rpx; color: #fff;
  flex-shrink: 0;
}

.emp-check-item.checked .emp-check-box {
  background: #0891b2; border-color: #0891b2;
}

.emp-check-label {
  font-size: 22rpx; color: #334155;
}

.emp-save-row {
  margin-top: 20rpx; text-align: right;
}

.emp-save-btn {
  padding: 14rpx 40rpx; border-radius: 12rpx; font-size: 26rpx;
  font-weight: 600; margin: 0;
}

.emp-save-btn.primary { background: #0f766e; color: #fff; }

/* 管理员操作行（仅超管可见） */
.emp-admin-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.emp-mini-btn {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-weight: 500;
  margin: 0;
  line-height: 1.4;
}

.emp-mini-btn.primary { background: #0f766e; color: #fff; }
.emp-mini-btn.ghost   { background: #f1f5f9; color: #334155; }
.emp-mini-btn.success { background: #16a34a; color: #fff; }
.emp-mini-btn.danger  { background: #fef2f2; color: #b91c1c; border: 1rpx solid #fecaca; }

/* ===== 月度统计（保留原有样式） ===== */
.prod-toolbar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx; gap: 12rpx; flex-wrap: wrap;
}

/* 统计口径切换（操作根数 / 配合根数） */
.prod-mode-switch {
  display: flex; gap: 8rpx; padding: 6rpx;
  background: #f1f5f9; border-radius: 12rpx; margin-bottom: 10rpx;
}

.prod-mode-item {
  flex: 1; text-align: center; padding: 12rpx 0;
  font-size: 24rpx; color: #475569; border-radius: 10rpx;
}

.prod-mode-item.active {
  color: #ffffff; font-weight: 600;
  background: linear-gradient(135deg, #0f766e, #0d9488);
}

.prod-mode-tip {
  font-size: 20rpx; color: #94a3b8; line-height: 1.5;
  margin-bottom: 14rpx;
}

.prod-emp-picker {
  padding: 14rpx 24rpx;
  border: 2rpx solid #e2e8f0; border-radius: 12rpx;
  font-size: 26rpx; color: #1e293b; background: #f8fafc;
  min-width: 260rpx;
}

.prod-export-btns { display: flex; gap: 10rpx; }

.prod-export-btn {
  padding: 12rpx 22rpx; border-radius: 10rpx; font-size: 22rpx;
  line-height: 1.5; margin: 0;
}

.prod-export-btn.primary { background: #0f766e; color: #fff; }
.prod-export-btn.ghost { background: #f1f5f9; color: #475569; }

/* 两层结构：左侧员工/月份列固定，右侧月份区独立横向滚动 */
.prod-scroll { flex: 1 1 0; min-width: 0; overflow: auto; }

.prod-table { display: flex; align-items: flex-start; }

.prod-fixed-col {
  flex-shrink: 0;
  width: calc(170rpx * var(--pz, 1));
  border-right: 2rpx solid #e2e8f0;
  box-shadow: 10rpx 0 14rpx -12rpx rgba(15, 23, 42, 0.18);
  position: relative;
  z-index: 2;
}

.prod-fixed-cell {
  height: calc(88rpx * var(--pz, 1));
  display: flex; align-items: center; justify-content: center; text-align: center;
  font-size: calc(22rpx * var(--pz, 1));
  background: #f8fafc;
  border-top: 1rpx solid #e2e8f0;
  padding: 0 calc(6rpx * var(--pz, 1));
  overflow: hidden;
}

.prod-fixed-cell.prod-fixed-head { border-top: none; font-weight: 700; }

.prod-months-inner { min-width: calc(660rpx * var(--pz, 1)); }

.prod-months-inner .prod-row {
  display: grid;
  grid-template-columns: repeat(12, 1fr) calc(96rpx * var(--pz, 1));
  gap: calc(6rpx * var(--pz, 1));
  padding: 0;
  border-top: 1rpx solid #e2e8f0;
  align-items: stretch;
}

.prod-months-inner .prod-row.prod-head { border-top: none; }

.prod-cell {
  border-radius: 8rpx;
  background: #f8fafc; font-size: calc(22rpx * var(--pz, 1)); text-align: center;
  height: calc(88rpx * var(--pz, 1));
  display: flex; align-items: center; justify-content: center;
  padding: 0 calc(4rpx * var(--pz, 1));
}

.total-cell { font-weight: 700; }

.prod-cell.has-data { background: #f0fdf4; color: #166534; font-weight: 600; }

.bold { font-weight: 700; }

.prod-all-section { margin-top: 28rpx; }

.prod-subtitle {
  font-size: 28rpx; font-weight: 700; color: #334155;
  margin-bottom: 12rpx;
}

.prod-emp-name {
  font-size: calc(24rpx * var(--pz, 1)); font-weight: 600;
  max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* 表格缩放工具条（月度统计） */
.prod-zoom-bar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16rpx; gap: 12rpx;
}
.prod-zoom-label { font-size: 24rpx; color: #64748b; }
.prod-zoom-controls { display: flex; align-items: center; gap: 12rpx; }
.prod-zoom-btn {
  width: 64rpx; height: 64rpx; border-radius: 12rpx;
  background: #ffffff; border: 2rpx solid #cbd5e1;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 700; color: #334155;
}
.prod-zoom-btn.disabled { color: #cbd5e1; }
.prod-zoom-val { font-size: 26rpx; font-weight: 700; color: #1d4ed8; min-width: 90rpx; text-align: center; }
.prod-zoom-reset {
  padding: 8rpx 20rpx; border-radius: 999rpx;
  background: #f1f5f9; font-size: 24rpx; color: #475569;
}

/* ===== 主操作按钮：扫码进单 / 我的工单（员工高频入口，放大置顶）===== */
.main-actions {
  gap: 20rpx;
  margin-top: 30rpx;
}

/* 两个主按钮统一样式：Apple 风琥珀金渐变——8 档色标深邃过渡（顶部受光，
   向下逐渐沉入深琥珀棕），叠加顶部高光与柔和投影 */
.main-btn {
  flex: 1 1 50%;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 2.5;
  border-radius: 20rpx;
  background: linear-gradient(180deg,
    #fcd34d 0%,
    #fbbf24 14%,
    #f59e0b 30%,
    #e88b0a 46%,
    #d97706 62%,
    #c05e08 78%,
    #a34a06 90%,
    #8f3f05 100%);
  color: #ffffff;
  text-shadow: 0 1rpx 2rpx rgba(120, 53, 15, 0.4);
  box-shadow:
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.4),
    inset 0 -3rpx 8rpx rgba(120, 53, 15, 0.35),
    0 8rpx 20rpx rgba(180, 83, 9, 0.42);
}

/* 按下态：微微下沉变暗，反馈清晰 */
.main-btn:active {
  transform: scale(0.98);
  background: linear-gradient(180deg,
    #e88b0a 0%,
    #d97706 30%,
    #b45309 68%,
    #92400e 100%);
  box-shadow:
    inset 0 2rpx 6rpx rgba(120, 53, 15, 0.35),
    0 4rpx 10rpx rgba(180, 83, 9, 0.32);
}

/* 次操作区：缩小一号，与主操作拉开层级 */
.sub-actions {
  margin-top: 18rpx;
}

.sub-actions .action-btn {
  font-size: 25rpx;
  line-height: 2.3;
}
