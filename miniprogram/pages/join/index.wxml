<view class="container page-join">
  <view class="top-left-home" bindtap="goToHome">
    <text class="home-icon">⌂</text>
  </view>

  <view class="hero card">
    <view class="title">申请加入系统</view>
    <view class="subtle">填写姓名并选择您的岗位，提交后等待管理员审批即可使用系统。</view>
  </view>

  <view class="section card">
    <view class="subtitle">填写申请信息</view>

    <view class="form-field">
      <view class="field-label">姓名<text class="required">*</text></view>
      <input class="form-input" placeholder="请输入您的姓名" value="{{name}}" bindinput="bindNameInput" confirm-type="done" cursor-spacing="20" />
    </view>

    <view class="form-field">
      <view class="field-label">岗位<text class="required">*</text>（多选）</view>
      <view class="station-grid">
        <view
          wx:for="{{allStations}}"
          wx:key="station"
          wx:for-index="idx"
          class="station-chip {{item.checked ? 'checked' : ''}}"
          data-station="{{item.station}}"
          data-index="{{idx}}"
          bindtap="toggleStation"
        >{{item.station}}</view>
      </view>
      <view wx:if="{{stations.length > 0}}" class="selected-hint">已选：{{stations.join('、')}}</view>
    </view>

    <view class="actions">
      <button class="primary-btn" bindtap="submitApplication" disabled="{{submitting}}" loading="{{submitting}}">{{submitting ? '提交中...' : '提交申请'}}</button>
    </view>
  </view>
</view>
