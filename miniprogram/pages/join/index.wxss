.page-join {
  padding-bottom: 40rpx;
}

.hero,
.section {
  padding: 28rpx;
}

.hero {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #ffffff;
}

.hero .title,
.hero .subtle {
  color: #ffffff;
}

.section {
  margin-top: 24rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: #1e293b;
}

.form-field {
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 10rpx;
  display: block;
}

.required {
  color: #e53935;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.station-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.station-chip {
  padding: 12rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 26rpx;
  color: #475569;
  transition: all 0.15s;
}

.station-chip.checked {
  background: #0f766e;
  border-color: #0f766e;
  color: #ffffff;
  font-weight: 600;
  position: relative;
  padding-right: 48rpx;
  transform: scale(1.04);
  box-shadow: 0 2rpx 8rpx rgba(15, 118, 110, 0.3);
}

.station-chip.checked::after {
  content: '✓';
  position: absolute;
  right: 14rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}

.selected-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #0f766e;
  font-weight: 500;
}

.actions {
  margin-top: 28rpx;
}

.primary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-btn[disabled] {
  background: #94a3b8;
  color: #f1f5f9;
}
