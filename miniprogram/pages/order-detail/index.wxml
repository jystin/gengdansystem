<view wx:if="{{order}}" class="container page-order-detail {{editingFields ? 'editing-mode' : ''}} {{elderMode ? 'elder' : ''}}">
  <view class="top-left-home" bindtap="goToHome">
    <text class="home-icon">⌂</text>
  </view>
  <view class="summary card {{order.urgent ? 'urgent' : ''}}">
    <view class="row">
      <view>
        <view class="title">{{order.id}}</view>
        <view class="order-customer">{{order.customerName}}</view>
      </view>
      <view class="row-actions">
        <view wx:if="{{isAdmin && order.status !== 'completed' && !editingFields}}" class="btn-edit" bindtap="enterEditFields">编辑</view>
        <view wx:if="{{isAdmin && order.status !== 'completed' && editingFields}}" class="btn-save-top {{editBtnLoading ? 'btn-disabled' : ''}}" bindtap="saveEditFields">{{editBtnLoading ? '保存中' : '保存'}}</view>
        <text class="badge {{order.paused ? 'badge-warning' : order.status === 'completed' ? 'badge-success' : order.overdue ? 'badge-danger' : order.urgent ? 'badge-urgent' : 'badge-info'}}">{{order.statusLabel}}</text>
      </view>
    </view>

    <!-- 展示模式:基础字段 -->
    <view wx:if="{{!editingFields}}" class="summary-grid">
      <view class="field-item"><text class="field-label">种类</text><text class="field-value">{{order.type}}</text></view>
      <view class="field-item"><text class="field-label">尺寸</text><text class="field-value">{{order.size}}</text></view>
      <view class="field-item"><text class="field-label">数量</text><text class="field-value">{{order.qty}}</text></view>
      <view class="field-item"><text class="field-label">单号</text><text class="field-value">{{order.singleNo}}</text></view>
      <view class="field-item"><text class="field-label">材质</text><text class="field-value">{{order.material}}</text></view>
      <view class="field-item"><text class="field-label">进度</text><text class="field-value">{{order.progress}}%</text></view>
      <view class="field-item"><text class="field-label">交期</text><text class="field-value">{{order.dueDate}}</text></view>
      <view class="field-item"><text class="field-label">下单日期</text><text class="field-value">{{order.orderDate}}</text></view>
      <view class="field-item" wx:if="{{order.completedDate}}"><text class="field-label">完成日期</text><text class="field-value">{{order.completedDate}}</text></view>
    </view>

    <!-- 编辑模式:基础字段(可改) + 备注 -->
    <view wx:else class="edit-fields">
      <view class="edit-grid">
        <view class="field-item">
          <text class="field-label">种类 *</text>
          <input class="edit-input" value="{{editFieldsDraft.type}}" data-key="type" bindinput="onEditFieldInput" />
        </view>
        <view class="field-item">
          <text class="field-label">尺寸 *</text>
          <input class="edit-input" value="{{editFieldsDraft.size}}" data-key="size" bindinput="onEditFieldInput" />
        </view>
        <view class="field-item">
          <text class="field-label">数量 *</text>
          <input class="edit-input" type="number" value="{{editFieldsDraft.qty}}" data-key="qty" bindinput="onEditFieldInput" />
        </view>
        <view class="field-item">
          <text class="field-label">单号</text>
          <input class="edit-input" value="{{editFieldsDraft.singleNo}}" data-key="singleNo" bindinput="onEditFieldInput" />
        </view>
        <view class="field-item">
          <text class="field-label">材质 *</text>
          <input class="edit-input" value="{{editFieldsDraft.material}}" data-key="material" bindinput="onEditFieldInput" />
        </view>
        <view class="field-item">
          <text class="field-label">交期</text>
          <!-- 微信小程序不支持 input type=date，必须用 picker mode=date 才能唤起原生日历（与创建页一致） -->
          <picker mode="date" value="{{editFieldsDraft.dueDate}}" data-key="dueDate" bindchange="onEditFieldDate">
            <view class="edit-input {{editFieldsDraft.dueDate ? '' : 'placeholder'}}">{{editFieldsDraft.dueDate || '请选择日期'}}</view>
          </picker>
        </view>
        <view class="field-item">
          <text class="field-label">下单日期</text>
          <picker mode="date" value="{{editFieldsDraft.orderDate}}" data-key="orderDate" bindchange="onEditFieldDate">
            <view class="edit-input {{editFieldsDraft.orderDate ? '' : 'placeholder'}}">{{editFieldsDraft.orderDate || '请选择日期'}}</view>
          </picker>
        </view>
        <view class="field-item">
          <text class="field-label">备注</text>
          <input class="edit-input" value="{{editFieldsDraft.remarks}}" data-key="remarks" bindinput="onEditFieldInput" />
        </view>
      </view>
    </view>

    <view class="progress-block">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{order.progress}}%"></view>
      </view>
    </view>
  </view>


  <view class="section card action-panel {{panelFlash ? 'panel-flash' : ''}}">
    <view class="section-title">操作面板</view>

    <!-- 认领区块（并行模型）：进度提示 + 我认领的工序 + 可认领的工序 -->
    <view wx:if="{{order.status !== 'completed'}}" class="claim-section">
      <!-- 进度提示：完成道数 + 最新提交的工序 -->
      <view class="claim-bar mismatch">
        <view class="claim-info">
          <text class="claim-main">本单进度：已完成 {{doneCount}}/{{totalSteps}} 道</text>
          <text class="claim-sub">{{lastSubmitStepName ? '最新提交：' + lastSubmitStepName + ' · ' + lastSubmitStepStation : '各工序暂无提交，直接认领你的岗位工序即可开工'}}</text>
        </view>
      </view>

      <!-- 可认领的工序（全部未完成 + 岗位匹配，可多人协作） -->
      <view wx:if="{{claimableSteps.length > 0}}" class="my-claim-list">
        <view class="my-claim-title">可认领的工序</view>
        <view wx:for="{{claimableSteps}}" wx:key="index" class="my-claim-row">
          <view class="my-claim-info">
            <text class="my-claim-name">{{item.stepName}}</text>
            <text class="my-claim-station">{{item.station}}</text>
          </view>
          <view class="my-claim-actions">
            <block wx:if="{{item.has}}">
              <text class="step-claim-chip {{item.mine ? 'mine' : 'other'}}">{{item.mine ? '✓ 我已认领' : item.names}}</text>
              <button wx:if="{{item.mine || isAdmin}}" size="mini" class="step-claim-release" catchtap="releaseStepClaim" data-step-index="{{item.index}}" loading="{{claimBtnLoading}}">撤销</button>
              <button wx:if="{{item.canClaim}}" size="mini" class="step-claim-btn" catchtap="claimStep" data-step-index="{{item.index}}" loading="{{claimBtnLoading}}">＋ 加入认领</button>
            </block>
            <button wx:elif="{{item.canClaim}}" size="mini" class="step-claim-btn" catchtap="claimStep" data-step-index="{{item.index}}" loading="{{claimBtnLoading}}">＋ 认领</button>
          </view>
        </view>
      </view>

      <!-- 我认领的工序（点击切换填写目标） -->
      <view wx:if="{{myClaimSteps.length > 0}}" class="my-claim-list">
        <view class="my-claim-title">我认领的工序（点击填写）</view>
        <view class="claim-chip-row">
          <view wx:for="{{myClaimSteps}}" wx:key="index"
                class="claim-chip {{selectedStepIdx === item.index ? 'active' : ''}}"
                data-step-index="{{item.index}}"
                bindtap="selectPanelStep">
            <text class="claim-chip-name">{{item.stepName}}</text>
            <text class="claim-chip-acc">{{item.acc}}/{{qtyTarget}}</text>
          </view>
        </view>
      </view>

      <!-- 无可认领也无可填写：全部完成或无匹配工种 -->
      <view wx:if="{{claimableSteps.length === 0 && myClaimSteps.length === 0 && !canComplete}}" class="claim-bar free">
        <view class="claim-info">
          <text class="claim-main">暂无可操作的工序</text>
          <text class="claim-sub">工序均已完成，或与你的工种不匹配</text>
        </view>
      </view>
    </view>

    <view wx:if="{{canComplete}}">
      <!-- 当前填写目标工序（并行模型：在我认领的工序间切换） -->
      <view class="selected-step-line">
        <text class="selected-step-name">填写：{{currentStepName}}<text class="selected-step-station">（{{currentStepStation}}）</text></text>
        <text class="selected-step-acc">累计 {{selectedAcc}}/{{qtyTarget}} 根{{selectedClaimCount > 1 ? ' · ' + selectedClaimCount + ' 人认领' : ''}}</text>
      </view>

      <!-- 操作员选择（所有工序都需要） -->
      <view class="form-field">
        <view class="form-label">工序操作员<text class="required-star">*</text></view>
        <view class="operator-select" bindtap="showEmployeePicker" data-target="operator">
          <text class="{{operatorId ? '' : 'placeholder'}}">{{operatorLabel || '请选择操作员'}}</text>
          <text class="select-arrow">▾</text>
        </view>
      </view>

      <!-- 配合人员选择（敦压 / 拉尾子 / 精车 / 铣方头 = 编程员；打字 = 调字员） -->
      <view wx:if="{{isProgrammerStep}}" class="form-field">
        <view class="form-label">{{partnerLabel}}<text class="required-star">*</text></view>
        <view class="operator-select" bindtap="showEmployeePicker" data-target="programmer">
          <text class="{{programmerId ? '' : 'placeholder'}}">{{programmerId ? programmerLabel : '请选择' + partnerLabel}}</text>
          <text class="select-arrow">▾</text>
        </view>
        <view wx:if="{{programmerFallback}}" class="form-hint warm">系统里还没有{{partnerLabel}}，请到「员工管理」给对应员工分配含「{{partnerKeyword}}」的岗位后再回来填写。</view>
      </view>

      <!-- 下料工序：需要填写材料消耗 -->
      <view wx:if="{{isBlankingStep}}">
        <view class="material-tip">下料工序请填写材料消耗，系统将自动扣减库存</view>

        <view class="form-field">
          <view class="form-label">材料类型<text class="required-star">*</text></view>
          <picker mode="selector" range="{{materialTypes}}" bindchange="bindMaterialType">
            <view class="form-picker">
              <text class="{{materialConsumption.material ? '' : 'placeholder'}}">{{materialConsumption.material || '请选择材料'}}</text>
              <text class="select-arrow">▾</text>
            </view>
          </picker>
        </view>

        <view class="form-field">
          <view class="form-label">粗度（mm）<text class="required-star">*</text></view>
          <input class="form-input" type="digit" placeholder="0-200，如 80" value="{{materialConsumption.roughness}}" bindinput="bindMaterialRoughness" confirm-type="done" />
        </view>

        <view class="form-field">
          <view class="form-label">长度（mm）<text class="required-star">*</text></view>
          <input class="form-input" type="digit" placeholder="如 120，图纸有值则自动填充" value="{{materialConsumption.length}}" bindinput="bindMaterialLength" confirm-type="done" />
        </view>

        <view wx:if="{{calcWeightInfo && isAdmin}}" class="calc-weight-card">
          <view class="calc-weight-title">材料消耗量计算</view>
          <view class="calc-weight-row"><text class="calc-label">粗度系数</text><text class="calc-value">{{calcWeightInfo.coef}} kg/m</text></view>
          <view class="calc-weight-row"><text class="calc-label">单根重量</text><text class="calc-value highlight">{{calcWeightInfo.singleWeightKg}} kg</text></view>
          <view class="calc-weight-row"><text class="calc-label">总消耗量</text><text class="calc-value highlight strong">{{calcWeightInfo.totalTons}} 吨</text></view>
          <view class="calc-divider"></view>
          <view class="calc-weight-row"><text class="calc-label">当前库存</text><text class="calc-value">{{calcWeightInfo.currentStock}} 吨</text></view>
          <view class="calc-weight-row"><text class="calc-label">剩余库存</text><text class="calc-value {{Number(calcWeightInfo.remainStock) >= 0 ? 'highlight' : 'danger'}} strong">{{calcWeightInfo.remainStock}} 吨</text></view>
        </view>

        <view class="form-field">
          <view class="form-label">消耗数量（根）<text class="required-star">*</text></view>
          <input class="form-input" type="number" placeholder="请输入本次消耗数量" value="{{materialConsumption.qty}}" bindinput="bindMaterialQty" confirm-type="done" />
        </view>
      </view>

      <!-- 其他工序 -->
      <view wx:else>
        <view class="form-field">
          <view class="form-label">实际处理根数<text class="required-star">*</text></view>
          <input class="form-input" type="digit" placeholder="请输入实际处理根数" value="{{completedQty}}" bindinput="onQtyInput" bindblur="onQtyBlur" confirm-type="done" cursor-spacing="20" />
        </view>
      </view>
    </view>

    <!-- 一键完成剩余工序（仅管理员/流转工）：剩余多于 1 道时显示 -->
    <view wx:if="{{(isAdmin || isFloater) && canComplete && batchRemaining > 1 && order.status !== 'completed'}}" class="batch-section">
      <button class="batch-toggle" bindtap="toggleBatchForm">一键完成</button>
      <view wx:if="{{batchOpen}}" class="batch-form">
        <view class="form-label">工序操作员<text class="required-star">*</text></view>
        <view class="operator-select" bindtap="showEmployeePicker" data-target="operator">
          <text class="{{operatorId ? '' : 'placeholder'}}">{{operatorLabel || '请选择操作员'}}</text>
          <text class="select-arrow">▾</text>
        </view>
        <view class="form-label" style="margin-top: 16rpx;">每道工序根数<text class="required-star">*</text></view>
        <input class="form-input" type="number" placeholder="每道工序完成多少根" value="{{batchQty}}" bindinput="onBatchQtyInput" />
        <button class="primary-btn" style="margin-top: 12rpx;" bindtap="submitBatchComplete" loading="{{batchSubmitting}}">确定一键完成</button>
      </view>
    </view>

    <view class="action-row">
      <button class="primary-btn" bindtap="completeStep" disabled="{{!canComplete || order.status === 'completed'}}">完成</button>
      <button wx:if="{{isAdmin && order.status !== 'completed'}}" class="secondary-btn {{order.urgent ? 'urgent-btn' : ''}}" bindtap="toggleUrgent">{{order.urgent ? '取消加急' : '设为加急'}}</button>
      <button wx:if="{{isAdmin && order.status !== 'completed'}}" class="secondary-btn" bindtap="togglePause">{{order.paused ? '恢复工单' : '暂停工单'}}</button>
    </view>

    <!-- 完工确认（并行模型收尾）：所有工序完成并提交根数后，入库仓管员/管理员确认 -->
    <view wx:if="{{canFinalize}}" class="action-row">
      <button class="primary-btn finalize-btn" bindtap="finalizeOrderConfirm" loading="{{finalizing}}">工单已完成</button>
    </view>
  </view>

  <view class="section card">
    <view class="section-title-row">
      <text class="section-title">工序流转</text>
      <button wx:if="{{!editingSteps && (currentUser.role === 'admin' || currentUser.role === 'superadmin')}}" class="edit-btn" bindtap="enterEditSteps">编辑工序</button>
    </view>

    <view wx:if="{{editingSteps}}" class="step-editor">
      <view class="step-group">
        <view class="group-title">可选工序</view>
        <view class="step-list">
          <view wx:for="{{processList}}" wx:key="key" class="step-item">
            <view class="step-info">
              <view class="step-name">{{item.name}}</view>
              <view class="step-station">{{item.station}}</view>
            </view>
            <button class="add-step-btn" bindtap="addStep" data-key="{{item.key}}">添加</button>
          </view>
        </view>
      </view>

      <view class="step-group">
        <view class="group-title">已选工序（按执行顺序）</view>
        <view wx:if="{{selectedSteps.length === 0}}" class="empty-hint">暂无已选工序</view>
        <view wx:else class="step-list">
          <view wx:for="{{selectedSteps}}" wx:key="instanceId" class="step-item selected {{!item.canDelete ? 'locked' : ''}}">
            <view class="step-order">{{index + 1}}</view>
            <view class="step-info">
              <view class="step-name">{{item.name}}</view>
              <view class="step-station">{{item.station}}</view>
            </view>
            <view class="step-controls">
              <button wx:if="{{item.canRevert}}" class="step-revert-btn" bindtap="revertStep" data-instance-id="{{item.instanceId}}">撤回</button>
              <button wx:elif="{{item.canDelete}}" class="step-delete-btn" bindtap="removeSelectedStep" data-instance-id="{{item.instanceId}}">删</button>
              <text wx:else class="locked-tag">已完成</text>
            </view>
          </view>
        </view>
      </view>

      <view class="editor-actions">
        <button class="primary-btn" bindtap="saveStepChanges">保存工序</button>
        <button class="secondary-btn" bindtap="exitEditSteps">取消</button>
      </view>
    </view>

    <block wx:else>
      <block wx:for="{{order.steps}}" wx:key="_stepKey">
        <view class="step-item {{stepClaimFlags[index].done ? 'done' : (index === order.currentStepIndex && !stepClaimFlags[index].done ? 'current' : '')}}">
          <view class="step-dot"></view>
          <view class="step-body">
            <view class="row">
              <view class="step-name-wrap">
                <text class="step-name">{{item.name}}</text>
                <text wx:if="{{item.needProgrammer}}" class="step-tag">需{{item.partnerLabel || '编程员'}}</text>
              </view>
              <text class="subtle">{{item.station}}</text>
              <button wx:if="{{isAdmin && stepClaimFlags[index].done}}" class="step-revert-btn" bindtap="revertStep" data-step-key="{{item.key}}" data-step-index="{{index}}">撤回</button>
            </view>
            <block wx:if="{{stepRecordLines[index] && stepRecordLines[index].length > 0}}">
              <view class="subtle" wx:for="{{stepRecordLines[index]}}" wx:for-item="rec" wx:key="completedAt">{{rec.operator}} - {{rec.completedAt}}{{rec.qty ? ' - ' + rec.qty + '根' : ''}}{{rec.partial ? '（部分）' : ''}}{{rec.programmerName ? ' - ' + (rec.partnerRole || '编程员') + ' ' + rec.programmerName : ''}}</view>
            </block>
            <!-- 工序汇总：完成状态 + 累计根数 + 认领人数 -->
            <view class="step-summary {{stepClaimFlags[index].done ? 'done' : (stepClaimFlags[index].acc > 0 ? 'doing' : '')}}">
              <text wx:if="{{stepClaimFlags[index].done}}">✓ 已完成 · 累计 {{stepClaimFlags[index].acc}}/{{stepClaimFlags[index].qty}} 根</text>
              <text wx:elif="{{stepClaimFlags[index].acc > 0}}">进行中 · 累计 {{stepClaimFlags[index].acc}}/{{stepClaimFlags[index].qty}} 根{{stepClaimFlags[index].has ? ' · ' + stepClaimFlags[index].count + '人认领' : ''}}</text>
              <text wx:elif="{{stepClaimFlags[index].has}}">已认领 {{stepClaimFlags[index].count}} 人 · 待提交根数</text>
              <text wx:else>等待处理</text>
            </view>
            <!-- 认领管理：仅显示认领人与撤销；认领入口统一在上方操作面板「可认领的工序」 -->
            <view wx:if="{{stepClaimFlags[index] && stepClaimFlags[index].has}}" class="step-claim-row">
              <text class="step-claim-chip {{stepClaimFlags[index].mine ? 'mine' : 'other'}}">{{stepClaimFlags[index].mine ? '✓ 我已认领' : stepClaimFlags[index].names}}</text>
              <button wx:if="{{stepClaimFlags[index].mine || isAdmin}}" size="mini" class="step-claim-release" catchtap="releaseStepClaim" data-step-index="{{index}}" loading="{{claimBtnLoading}}">撤销</button>
            </view>
          </view>
        </view>
      </block>
    </block>
  </view>

  <view class="section card">
    <view class="section-title-row">
      <text class="section-title">图纸附件（{{drawingCount}}份）</text>
      <button wx:if="{{isAdmin}}" class="upload-btn small" bindtap="chooseDrawing">{{isDesktopPlatform ? '上传图纸（支持 PDF）' : '上传图纸'}}</button>
    </view>

    <view class="drawing-grid" wx:if="{{hasDrawings}}">
      <!-- 已上传图纸：图片显示缩略图，PDF 显示文件卡片 -->
      <block wx:for="{{drawingUrls}}" wx:key="key">
        <view class="drawing-thumb drawing-uploaded {{item.isPDF ? 'drawing-file-card' : ''}}">
          <image
            wx:if="{{!item.isPDF}}"
            class="drawing-thumb-img"
            src="{{item.url}}"
            mode="aspectFill"
            show-menu-by-longpress="{{true}}"
            data-index="{{index}}"
            bindtap="previewDrawing"
          />
          <view wx:else class="drawing-file" data-index="{{index}}" bindtap="previewDrawing">
            <text class="drawing-file-icon">PDF</text>
            <text class="drawing-file-name">{{item.name || '图纸文件'}}</text>
          </view>
          <view wx:if="{{isAdmin}}" class="drawing-delete" data-index="{{index}}" data-file-id="{{item.fileID}}" bindtap="deleteUploadedDrawing">×</view>
        </view>
      </block>
      <!-- 待上传图纸 -->
      <block wx:for="{{pendingDrawings}}" wx:key="key">
        <view class="drawing-thumb drawing-pending {{item.isPDF ? 'drawing-file-card' : ''}}">
          <image
            wx:if="{{!item.isPDF}}"
            class="drawing-thumb-img"
            src="{{item.tempFilePath}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="previewPendingDrawing"
          />
          <view wx:else class="drawing-file" data-index="{{index}}" bindtap="previewPendingDrawing">
            <text class="drawing-file-icon">PDF</text>
            <text class="drawing-file-name">{{item.name || '图纸文件'}}</text>
          </view>
          <text class="drawing-pending-tag">待上传</text>
          <view class="drawing-delete" data-index="{{index}}" bindtap="removePendingDrawing">×</view>
        </view>
      </block>
    </view>
    <view wx:else class="empty-hint">暂无图纸</view>

    <view wx:if="{{hasPending}}" class="drawing-save-bar">
      <button class="primary-btn" bindtap="saveDrawings">保存图纸</button>
      <button class="secondary-btn" bindtap="clearPendingDrawings">取消</button>
    </view>
  </view>

  <view wx:if="{{order.drawingDetail && (order.drawingDetail.blankingRoughness || order.drawingDetail.productRoughness || order.drawingDetail.length || order.drawingDetail.blankingLength || order.drawingDetail.topHoleThread || order.drawingDetail.crossHole || order.drawingDetail.squareHead) || editingFields}}" class="section card">
    <view class="section-title">图纸细节</view>
    <!-- 展示模式 -->
    <view wx:if="{{!editingFields}}" class="detail-grid">
      <view class="detail-item"><text class="detail-label">下单数量</text><text class="detail-sep">：</text><text class="detail-value highlight">{{order.qty}}</text></view>
      <view wx:if="{{order.drawingDetail.blankingRoughness}}" class="detail-item"><text class="detail-label">下料粗度</text><text class="detail-sep">：</text><text class="detail-value">{{order.drawingDetail.blankingRoughness}}</text></view>
      <view wx:if="{{order.drawingDetail.productRoughness}}" class="detail-item"><text class="detail-label">成品粗度</text><text class="detail-sep">：</text><text class="detail-value">{{order.drawingDetail.productRoughness}}</text></view>
      <view wx:if="{{order.drawingDetail.length}}" class="detail-item"><text class="detail-label">长度</text><text class="detail-sep">：</text><text class="detail-value">{{order.drawingDetail.length}}</text></view>
      <view wx:if="{{order.drawingDetail.blankingLength}}" class="detail-item"><text class="detail-label">下料长度</text><text class="detail-sep">：</text><text class="detail-value">{{order.drawingDetail.blankingLength}}</text></view>
      <view wx:if="{{order.drawingDetail.topHoleThread}}" class="detail-item"><text class="detail-label">顶孔螺纹</text><text class="detail-sep">：</text><text class="detail-value">{{order.drawingDetail.topHoleThread}}</text></view>
      <view wx:if="{{order.drawingDetail.crossHole}}" class="detail-item"><text class="detail-label">横孔</text><text class="detail-sep">：</text><text class="detail-value">{{order.drawingDetail.crossHole}}</text></view>
      <view wx:if="{{order.drawingDetail.squareHead}}" class="detail-item full-width"><text class="detail-label">方头</text><text class="detail-sep">：</text><text class="detail-value">{{order.drawingDetail.squareHead}}</text></view>
    </view>
    <!-- 编辑模式:7 个图纸细节字段全部可填 -->
    <view wx:else class="detail-grid">
      <view class="detail-item"><text class="detail-label">下单数量</text><text class="detail-sep">：</text><text class="detail-value highlight">{{order.qty}}</text></view>
      <view class="detail-item"><text class="detail-label">下料粗度</text><input class="edit-input detail-input" value="{{editDetailDraft.blankingRoughness}}" data-key="blankingRoughness" bindinput="onEditDetailInput" /></view>
      <view class="detail-item"><text class="detail-label">成品粗度</text><input class="edit-input detail-input" value="{{editDetailDraft.productRoughness}}" data-key="productRoughness" bindinput="onEditDetailInput" /></view>
      <view class="detail-item"><text class="detail-label">长度</text><input class="edit-input detail-input" value="{{editDetailDraft.length}}" data-key="length" bindinput="onEditDetailInput" /></view>
      <view class="detail-item"><text class="detail-label">下料长度</text><input class="edit-input detail-input" value="{{editDetailDraft.blankingLength}}" data-key="blankingLength" bindinput="onEditDetailInput" /></view>
      <view class="detail-item"><text class="detail-label">顶孔螺纹</text><input class="edit-input detail-input" value="{{editDetailDraft.topHoleThread}}" data-key="topHoleThread" bindinput="onEditDetailInput" /></view>
      <view class="detail-item"><text class="detail-label">横孔</text><input class="edit-input detail-input" value="{{editDetailDraft.crossHole}}" data-key="crossHole" bindinput="onEditDetailInput" /></view>
      <view class="detail-item full-width"><text class="detail-label">方头</text><input class="edit-input detail-input" value="{{editDetailDraft.squareHead}}" data-key="squareHead" bindinput="onEditDetailInput" /></view>
    </view>
  </view>

  <view wx:if="{{isLoadingMore}}" class="section card loading-more">
    <view class="loading-more-text">正在加载员工、材料等参考数据…</view>
  </view>

  <view class="section card">
    <!-- 二维码默认折叠：下拉页面到底部或点标题展开 -->
    <view class="section-title-row qr-toggle" bindtap="toggleQrSection">
      <view class="section-title">订单二维码{{qrExpanded ? '' : '（已折叠，下拉页面或点此展开）'}}</view>
      <text class="qr-toggle-arrow {{qrExpanded ? 'open' : ''}}">▾</text>
    </view>
    <block wx:if="{{qrExpanded}}">
    <view class="subtle">二维码内容绑定工单号：{{order.qrContent || order.id}}</view>
    <view class="qr-tip {{isDevtools ? 'qr-tip-warn' : ''}}">
      <block wx:if="{{isDevtools}}">开发者工具无法模拟「另存为」对话框（官方限制，非小程序代码问题）。请用<text class="qr-tip-strong">电脑版微信</text>打开本小程序验证。当前环境点「另存为…」会改为复制图片链接，贴到浏览器即可下载。</block>
      <block wx:elif="{{isDesktop}}">点「另存为…」可自选保存目录；也可点图片进入全屏预览后<text class="qr-tip-strong">右键</text>选择「图片另存为」。</block>
      <block wx:else>长按二维码图片可保存到相册或识别；也可点下方按钮保存。</block>
    </view>

    <!-- 主码：微信小程序码（太阳码） -->
    <view wx:if="{{order.qrCodeFileID}}" class="qr-wrap">
      <view class="qr-label">微信小程序码（员工用微信扫码直接进入）</view>
      <image
        class="qr-image"
        src="{{order.qrUrl}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
        data-kind="wxacode"
        bindtap="previewQrCode"
      />
      <view class="qr-tools">
        <view class="qr-tool qr-tool-primary" data-kind="wxacode" bindtap="saveQrCode">{{isDesktop ? '另存为…' : '保存到相册'}}</view>
      </view>
    </view>

    <!-- 备用码：文本二维码（小程序内扫码用） -->
    <view class="qr-wrap qr-text-wrap">
      <view class="qr-label qr-label-text">备用文本二维码（小程序内扫码或手动输入工单号）</view>
      <image
        class="qr-image qr-image-text"
        src="{{order.textQrUrl}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
        data-kind="text"
        bindtap="previewQrCode"
      />
      <view class="qr-tools">
        <view class="qr-tool qr-tool-primary" data-kind="text" bindtap="saveQrCode">{{isDesktop ? '另存为…' : '保存到相册'}}</view>
      </view>
    </view>

    <view class="subtle qr-note">
      <block wx:if="{{order.qrCodeFileID}}">微信扫码识别太阳码后可直接进入该工单详情</block>
      <block wx:else>当前仅文本二维码，点击下方按钮生成微信小程序码</block>
    </view>
    <button wx:if="{{isAdmin}}" class="secondary-btn" style="margin-top:12rpx" bindtap="regenerateWxacode" loading="{{qrRegenerating}}">
      {{qrRegenerating ? '生成中...' : (order.qrCodeFileID ? '重新生成小程序码' : '点击生成微信小程序码')}}
    </button>
    </block>
  </view>


  <view class="section card">
    <view class="section-title">全流程记录</view>
    <block wx:for="{{order.history}}" wx:key="completedAt">
      <view class="history-item">
        <view class="row">
          <text class="history-name">{{item.stepName}}</text>
          <text class="subtle">{{item.completedAt}}</text>
        </view>
        <view class="subtle">{{item.operator}} · {{item.role}}{{item.qty ? ' · 实际 ' + item.qty + ' 根' : ''}}{{item.programmerName ? ' · ' + (item.partnerRole || '编程员') + ' ' + item.programmerName : ''}}{{item.note ? ' · ' + item.note : ''}}</view>
      </view>
    </block>
  </view>
</view>

<view wx:else class="container">
  <view class="card empty-state">
    <view class="title">未找到工单</view>
    <view class="subtle">请返回列表或通过扫码进入。</view>
  </view>
</view>

<!-- 员工选择弹窗（操作员 / 配合人员 共用，按 pickerTarget 切换数据源） -->
<view wx:if="{{pickerTarget}}" class="op-picker-mask" bindtap="hideEmployeePicker">
  <view class="op-picker-panel" catchtap="onPickerPanelTap">
    <view class="op-picker-header">
      <text class="op-picker-title">{{pickerTarget === 'programmer' ? '选择' + partnerLabel : '选择操作员'}}</text>
      <text class="op-picker-close" bindtap="hideEmployeePicker">✕</text>
    </view>
    <scroll-view scroll-y class="op-employee-list">
      <block wx:for="{{pickerList}}" wx:key="id">
        <view class="op-employee-item {{pickerTarget === 'programmer' ? (programmerId === item.id ? 'selected' : '') : (operatorId === item.id ? 'selected' : '')}}"
              data-id="{{item.id}}"
              bindtap="selectEmployee">
          <view class="op-emp-name">{{item.name}}</view>
          <view class="op-emp-station">{{item._stationDisplay}}</view>
          <text wx:if="{{pickerTarget === 'programmer' ? programmerId === item.id : operatorId === item.id}}" class="op-check-icon">✓</text>
        </view>
      </block>
      <view wx:if="{{pickerList.length === 0}}" class="op-empty">{{pickerTarget === 'programmer' ? '暂无' + partnerLabel + '，请先在员工管理中给员工配置含「' + partnerKeyword + '」的岗位' : '当前工序仅限' + (currentStepStation || '对应岗位') + '或管理员操作，暂无可选人员，请到员工管理配置岗位'}}</view>
    </scroll-view>
  </view>
</view>

<!-- 编辑工单字段保存/取消按钮(仅编辑模式) -->
<view wx:if="{{editingFields}}" class="edit-actions">
  <button class="secondary-btn" bindtap="cancelEditFields" disabled="{{editBtnLoading}}">取消</button>
  <button class="primary-btn" bindtap="saveEditFields" loading="{{editBtnLoading}}" disabled="{{editBtnLoading}}">保存修改</button>
</view>
