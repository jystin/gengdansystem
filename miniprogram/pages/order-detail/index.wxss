.page-order-detail {
  padding-bottom: 40rpx;
}

.summary,
.section,
.empty-state {
  padding: 28rpx;
}

.summary.urgent {
  border: 2rpx solid #fca5a5;
  background: #fff1f2;
}

.summary.urgent .title {
  color: #dc2626;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.field-item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
}

.field-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.progress-block {
  margin-top: 22rpx;
}

.progress-bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0f766e, #14b8a6);
}

.section {
  margin-top: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.admin-tip {
  margin-bottom: 16rpx;
}

.no-permission-tip {
  margin-bottom: 16rpx;
  color: #f59e0b;
}

.step-item {
  display: flex;
  gap: 18rpx;
  padding: 16rpx 0;
}

.step-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #cbd5e1;
  flex-shrink: 0;
}

.step-item.done .step-dot {
  background: #14b8a6;
}

.step-item.current .step-dot {
  background: #f59e0b;
}

.step-body {
  flex: 1;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.step-item:last-child .step-body {
  border-bottom: none;
  padding-bottom: 0;
}

/* 工序名称：员工识别流程步骤的关键信息，放大显示 */
.step-name,
.history-name {
  font-size: 30rpx;
  font-weight: 600;
}

.drawing-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.drawing-thumb {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  overflow: hidden;
}

.drawing-thumb-img {
  width: 100%;
  height: 100%;
}

.drawing-pending {
  border: 2rpx dashed #cbd5e1;
}

.drawing-pending-tag {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  background: rgba(15, 23, 42, 0.7);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 6rpx 0;
}

.drawing-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: rgba(220, 38, 38, 0.9);
  color: #fff;
  font-size: 28rpx;
  border-bottom-left-radius: 12rpx;
}

/* ===== 图纸文件卡片（PDF 等非图片文件） ===== */
.drawing-file-card {
  background: #fff7f7;
}

.drawing-file {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

/* 待上传的 PDF 卡片底部留出「待上传」角标空间 */
.drawing-pending .drawing-file {
  padding-bottom: 52rpx;
}

.drawing-file-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #dc2626;
  background: #ffffff;
  border: 2rpx solid #fca5a5;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  letter-spacing: 1rpx;
}

.drawing-file-name {
  width: 100%;
  font-size: 18rpx;
  color: #64748b;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawing-save-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.drawing-save-bar .primary-btn,
.drawing-save-bar .secondary-btn {
  flex: 1;
  margin: 0;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.upload-btn.small {
  padding: 8rpx 16rpx !important;
  font-size: 22rpx !important;
  height: auto !important;
  line-height: 1.5 !important;
  margin: 0 !important;
}

.drawing-item,
.history-item {
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.drawing-item:first-child,
.history-item:first-child {
  border-top: none;
  padding-top: 0;
}

/* ===== 操作面板（表单样式） ===== */
.action-panel {
  position: relative;
  z-index: 10;
}

.form-field {
  margin-bottom: 20rpx;
}

/* ===== 操作面板表单：整体放大字号，方便员工在手机上看清 ===== */
.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 10rpx;
  display: block;
}

.required-star {
  color: #e53935;
  margin-right: 4rpx;
}

/* 表单标签里的浅色说明（如「本工序需要先编程」） */
.form-label-tip {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #94a3b8;
}

/* 表单下方的说明 / 警示文案 */
.form-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #94a3b8;
}

.form-hint.warm {
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
}

/* 可重复工序（精车）道数选择 */
.repeat-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.repeat-option {
  min-width: 116rpx;
  height: 72rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #334155;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
}

.repeat-option.active {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #0f766e, #0d9488);
  border-color: transparent;
}

/* 工序列表中「需编程」小标签 */
.step-name-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.step-tag {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #7c3aed;
  background: #f3e8ff;
  border-radius: 999rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 32rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #0f766e;
}

/* 下拉选择器（材料类型）—— 与 form-input 同一套视觉，
   之前误用了本页未定义的 .input，渲染成「没有框的纯文字」，容易漏填 */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 32rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.form-picker .placeholder {
  color: #94a3b8;
}

.form-textarea {
  width: 100%;
  min-height: 130rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 30rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: #0f766e;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.qr-wrap {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-text-wrap {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.qr-label {
  font-size: 24rpx;
  color: #475569;
  margin-bottom: 12rpx;
  text-align: center;
}
.qr-label-text {
  color: #94a3b8;
  font-size: 22rpx;
}

.qr-image {
  width: 320rpx;
  height: 320rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.qr-image-text {
  width: 240rpx;
  height: 240rpx;
  opacity: 0.85;
}

/* 二维码保存操作区 */
.qr-tip {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
  font-size: 22rpx;
  line-height: 1.6;
  color: #0f766e;
}

.qr-tip-warn {
  background: #fffbeb;
  border-color: #fde68a;
  color: #92400e;
}

.qr-tip-strong {
  font-weight: 700;
  color: inherit;
  text-decoration: underline;
}

.qr-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.qr-tool {
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #0f766e;
  background: #ffffff;
  border: 1rpx solid #99f6e4;
}

/* 主操作（另存为）：实心，和「复制链接」拉开层级 */
.qr-tool-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e, #0d9488);
  border-color: transparent;
  font-weight: 600;
  padding: 6rpx 28rpx;
}

.qr-tool:active {
  background: #ccfbf1;
}

.qr-tool-primary:active {
  background: linear-gradient(135deg, #0f766e, #0d9488);
  opacity: 0.85;
}

.qr-note {
  margin-top: 16rpx;
}

.primary-btn,
.secondary-btn {
  flex: 1;
  border-radius: 18rpx;
  line-height: 2.4;
  font-size: 26rpx;
}

.primary-btn {
  background: #0f766e;
  color: #ffffff;
}

.secondary-btn {
  background: #e2e8f0;
  color: #0f172a;
}

.secondary-btn.urgent-btn {
  background: #dc2626 !important;
  color: #ffffff !important;
}

.empty-state {
  margin-top: 24rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.edit-btn {
  padding: 0 12rpx !important;
  height: 40rpx !important;
  line-height: 40rpx;
  font-size: 22rpx !important;
  border-radius: 8rpx;
  background: #e0f2fe !important;
  color: #0369a1 !important;
  margin: 0 !important;
  border: none;
}

.edit-btn:active {
  background: #cffafe !important;
}

.step-editor {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.step-group {
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 12rpx;
  background: #ffffff;
}

.group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
  display: block;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.step-item {
  display: flex;
  align-items: center;
  padding: 8rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  gap: 8rpx;
  transition: all 0.2s;
}

.step-item:active {
  background: #f1f5f9;
}

.step-item.selected {
  background: #dbeafe;
  border-color: #0ea5e9;
}

.step-item.selected.locked {
  background: #f0fdf4;
  border-color: #86efac;
}

.step-item.selected.locked .step-order {
  background: #16a34a;
}

.step-item.selected.locked .step-name {
  color: #166534;
}

.step-checkbox {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 8rpx;
  cursor: pointer;
}

.step-checkbox .checkbox {
  width: 32rpx;
  height: 32rpx;
}

.step-info {
  flex: 1;
}

.step-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #1e293b;
}

.step-station {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 2rpx;
}

.step-order {
  width: 36rpx;
  height: 36rpx;
  background: #0ea5e9;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.step-controls {
  display: flex;
  gap: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.step-delete-btn {
  width: 48rpx !important;
  height: 48rpx !important;
  padding: 0 !important;
  line-height: 48rpx;
  text-align: center;
  background: #fee2e2 !important;
  color: #dc2626 !important;
  border-radius: 6rpx;
  font-size: 20rpx !important;
  margin: 0 !important;
}

.step-revert-btn {
  width: 64rpx !important;
  height: 48rpx !important;
  padding: 0 !important;
  line-height: 48rpx;
  text-align: center;
  background: #fef3c7 !important;
  color: #d97706 !important;
  border-radius: 6rpx;
  font-size: 20rpx !important;
  margin: 0 !important;
}

.add-step-btn {
  width: 72rpx !important;
  height: 48rpx !important;
  padding: 0 !important;
  line-height: 48rpx;
  text-align: center;
  background: #dcfce7 !important;
  color: #16a34a !important;
  border-radius: 6rpx;
  font-size: 22rpx !important;
  margin: 0 !important;
}

.locked-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 48rpx;
  font-size: 20rpx;
  color: #16a34a;
  background: #f0fdf4;
  border: 2rpx solid #86efac;
  border-radius: 6rpx;
  white-space: nowrap;
}

.empty-hint {
  padding: 16rpx;
  text-align: center;
  color: #64748b;
  font-size: 24rpx;
}

.editor-actions {
  grid-column: 1 / -1;
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.material-tip {
  padding: 16rpx 20rpx;
  background: #fef3c7;
  border: 2rpx solid #fcd34d;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #92400e;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.picker-input {
  display: flex;
  align-items: center;
  line-height: 80rpx;
}

.picker-input.placeholder {
  color: #94a3b8;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.detail-item {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
}

.detail-item.full-width {
  grid-column: 1 / -1;
}

.detail-label {
  font-size: 30rpx;
  color: #64748b;
}

.detail-sep {
  font-size: 30rpx;
  color: #94a3b8;
  margin: 0 4rpx;
}

.detail-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #2563eb;
}

.detail-value.highlight {
  font-size: 38rpx;
  font-weight: 700;
  color: #dc2626;
}

/* ===== 材料消耗量实时计算卡片 ===== */
.calc-weight-card {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
  border: 2rpx solid #86efac;
}

.calc-weight-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #166534;
  margin-bottom: 12rpx;
}

.calc-weight-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.calc-label {
  font-size: 24rpx;
  color: #4b5563;
}

.calc-value {
  font-size: 25rpx;
  font-weight: 600;
  color: #374151;
}

/* ===== 后台补充加载提示 ===== */
.loading-more {
  padding: 20rpx 28rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
}

.loading-more-text {
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
}

.calc-value.highlight {
  color: #059669;
}

.calc-value.highlight.strong {
  font-size: 28rpx;
  font-weight: 700;
}

.calc-weight-divider {
  height: 1rpx;
  background: rgba(134, 239, 172, 0.5);
  margin: 12rpx -8rpx;
}

.calc-value.danger {
  color: #dc2626;
}

/* ===== 操作员选择器 ===== */
.operator-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 32rpx;
  color: #1e293b;
}

.operator-select .placeholder {
  color: #94a3b8;
}

.select-arrow {
  color: #94a3b8;
  font-size: 30rpx;
}

/* 操作员搜索弹窗 */
.op-picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.op-picker-panel {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
}

.op-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.op-picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.op-picker-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 10rpx;
}

.op-search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.op-employee-list {
  max-height: 50vh;
}

.op-employee-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  transition: background 0.15s;
}

.op-employee-item:active {
  background: #f1f5f9;
}

.op-employee-item.selected {
  background: #f0fdf4;
  border: 2rpx solid #86efac;
}

.op-emp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
}

.op-emp-station {
  font-size: 22rpx;
  color: #64748b;
  margin-right: 16rpx;
}

.op-check-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #16a34a;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  flex-shrink: 0;
}

.op-empty {
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* ===== 删除图纸确认弹窗(自定义,绕开 wx.showModal 被吞) ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: min(560rpx, 88vw);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.modal-content-danger {
  border-top: 6rpx solid #dc2626;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.modal-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #475569;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.modal-btn {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  border: 1rpx solid transparent;
  background: #f1f5f9;
  color: #334155;
}

.modal-btn.cancel {
  background: #f1f5f9;
  color: #334155;
}

.modal-btn.danger {
  background: #dc2626;
  color: #ffffff;
}

/* ===== 编辑工单字段 ===== */
.row-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0; /* 防止被父 flex 挤压,badge "未开始" 等竖排 */
}

.btn-edit,
.btn-save-top {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0f766e, #0d9488);
  color: #ffffff;
  line-height: 1.5;
  white-space: nowrap;
  font-weight: 600;
}

.btn-edit:active,
.btn-save-top:active {
  opacity: 0.85;
}

.btn-disabled {
  opacity: 0.6;
}

.edit-fields {
  margin-top: 16rpx;
}

.edit-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx 24rpx;
}

.edit-input {
  width: 100%;
  padding: 10rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.edit-input:focus {
  border-color: #0f766e;
}

/* 日期 picker 的展示层复用 .edit-input；未选择时显示占位色 */
.edit-input.placeholder {
  color: #94a3b8;
}

.detail-input {
  background: #f8fafc;
  font-size: 24rpx;
  padding: 8rpx 14rpx;
}

.edit-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)) 32rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e2e8f0;
  box-shadow: 0 -4rpx 12rpx rgba(15, 23, 42, 0.08);
  z-index: 50;
}

/* 编辑模式时为页面底部留出固定按钮高度,避免遮挡最后一张卡片 */
.page-order-detail.editing-mode {
  padding-bottom: 140rpx;
}

/* ===== 工单认领 ===== */
.claim-section {
  margin-bottom: 20rpx;
}

.claim-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e2e8f0;
}

.claim-bar.free {
  background: #eff6ff;
  border-color: #bfdbfe;
}

.claim-bar.mine {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.claim-bar.other {
  background: #fffbeb;
  border-color: #fde68a;
}

.claim-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.claim-main {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.claim-bar.mine .claim-main {
  color: #15803d;
}

.claim-bar.other .claim-main {
  color: #b45309;
}

/* 当前工序与我的工种不匹配：流转进度提示 */
.claim-bar.mismatch {
  background: #fffbeb;
  border: 2rpx dashed #f59e0b;
}

.claim-bar.mismatch .claim-main {
  color: #b45309;
}

/* 我可认领的工序清单 */
.my-claim-list {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f0fdf4;
  border: 2rpx solid #bbf7d0;
}

.my-claim-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #15803d;
  margin-bottom: 14rpx;
}

.my-claim-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #dcfce7;
}

.my-claim-row:first-of-type {
  border-top: none;
}

.my-claim-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.my-claim-name {
  font-size: 45rpx;
  font-weight: 600;
  color: #0f172a;
}

.my-claim-station {
  font-size: 36rpx;
  color: #16a34a;
  background: #dcfce7;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
}

.my-claim-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

/* 我认领的工序 chips（面板填写目标切换） */
.claim-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.claim-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid #bbf7d0;
}

.claim-chip.active {
  /* 选中态用琥珀橙（与「当前工序」圆点同色），绿色留给「已完成」语义 */
  background: #f59e0b;
  border-color: #f59e0b;
}

.claim-chip-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #15803d;
}

.claim-chip.active .claim-chip-name {
  color: #ffffff;
}

.claim-chip-acc {
  font-size: 24rpx;
  color: #16a34a;
}

.claim-chip.active .claim-chip-acc {
  color: rgba(255, 255, 255, 0.9);
}

/* 面板「填写目标」提示行 */
.selected-step-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  /* 琥珀橙主题：与选中 chip / 当前工序圆点同色系，醒目 */
  background: #fffbeb;
  border: 2rpx solid #f59e0b;
  margin-bottom: 18rpx;
}

.selected-step-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #b45309;
}

.selected-step-station {
  font-size: 28rpx;
  font-weight: 400;
  color: #b45309;
}

.selected-step-acc {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d4ed8;
  flex-shrink: 0;
}

/* 工序流转列表汇总行（认领人数/累计根数/完成状态） */
.step-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.step-summary.doing {
  color: #1d4ed8;
  font-weight: 600;
}

.step-summary.done {
  color: #15803d;
  font-weight: 600;
}

/* 完工确认按钮（入库收尾） */
.finalize-btn {
  background: linear-gradient(135deg, #16a34a 0%, #15803d 100%);
  color: #ffffff;
}

/* 面板清单内按钮/标签放大 1.5 倍（不影响工序流转列表里的同名元素） */
.my-claim-actions .step-claim-btn {
  font-size: 33rpx;
  padding: 0 30rpx;
}

.my-claim-actions .step-claim-release {
  font-size: 33rpx;
  padding: 0 30rpx;
}

.my-claim-actions .step-claim-chip {
  font-size: 33rpx;
  padding: 8rpx 20rpx;
}

.claim-sub {
  font-size: 22rpx;
  color: #64748b;
}

.claim-mini-btn {
  flex-shrink: 0;
  margin: 0;
  font-size: 24rpx;
  line-height: 2.2;
  border-radius: 999rpx;
  padding: 0 24rpx;
}

.claim-mini-btn.primary {
  background: #16a34a;
  color: #fff;
}

.claim-mini-btn.warn {
  background: #fee2e2;
  color: #b91c1c;
}

.claim-mini-btn:not(.primary):not(.warn) {
  background: #f1f5f9;
  color: #475569;
}

/* ===== 按工序认领：工序流转列表里的未来工序认领入口 ===== */
.step-claim-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.step-claim-chip {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 32rpx;
}

.step-claim-chip.mine {
  background: #f0fdf4;
  color: #15803d;
}

.step-claim-chip.other {
  background: #fffbeb;
  color: #b45309;
}

.step-claim-btn {
  margin: 0;
  font-size: 22rpx;
  line-height: 2;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #0369a1;
}

.step-claim-release {
  margin: 0;
  font-size: 22rpx;
  line-height: 2;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  color: #b91c1c;
}

/* ===== 头部信息层级优化：工单号缩小次要化，公司名称放大突出 ===== */
.summary .title {
  font-size: 30rpx;
  font-weight: 600;
}

.summary .order-customer {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f766e;
}

/* ===== 当前工序：放大加红，一眼锁定 ===== */
.current-step-line {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #dc2626;
}

/* 扫码直达时操作面板闪烁提示 */
.action-panel.panel-flash {
  animation: panelFlash 1s ease-in-out 2;
}

@keyframes panelFlash {
  0%, 100% { box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06); }
  50% { box-shadow: 0 0 0 6rpx rgba(220, 38, 38, 0.35); }
}

/* ===== 大字模式（老年版）：个人中心开关后整页关键文字放大 ===== */
.page-order-detail.elder .title { font-size: 36rpx; }
.page-order-detail.elder .order-customer { font-size: 38rpx; }
.page-order-detail.elder .current-step-line { font-size: 38rpx; }
.page-order-detail.elder .section-title { font-size: 34rpx; }
.page-order-detail.elder .subtle { font-size: 28rpx; }
.page-order-detail.elder .field-label { font-size: 28rpx; }
.page-order-detail.elder .field-value { font-size: 32rpx; }
.page-order-detail.elder .form-label { font-size: 34rpx; }
.page-order-detail.elder .form-label-tip { font-size: 26rpx; }
.page-order-detail.elder .form-hint { font-size: 26rpx; }
.page-order-detail.elder .form-input,
.page-order-detail.elder .form-picker,
.page-order-detail.elder .operator-select { font-size: 36rpx; height: 96rpx; }
.page-order-detail.elder .form-textarea { font-size: 34rpx; min-height: 150rpx; }
.page-order-detail.elder .step-name { font-size: 34rpx; }
.page-order-detail.elder .claim-main { font-size: 30rpx; }
.page-order-detail.elder .claim-sub { font-size: 26rpx; }
.page-order-detail.elder .repeat-option { font-size: 32rpx; height: 80rpx; }

/* ===== 多人认领：他人认领条上的按钮组（加入认领 + 撤销） ===== */
.claim-btn-col {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

/* ===== 一键完成剩余工序 ===== */
.batch-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.batch-toggle {
  width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 2.4;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #c2410c;
  border: 2rpx solid #fdba74;
}

.batch-form {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

/* ===== 订单二维码折叠 ===== */
.qr-toggle {
  cursor: pointer;
}

.qr-toggle-arrow {
  font-size: 30rpx;
  color: #94a3b8;
  transition: transform 0.2s ease;
}

.qr-toggle-arrow.open {
  transform: rotate(180deg);
}

/* ===== 操作面板整体字号再放大（照顾年纪大的员工，仅作用于操作面板区块）===== */
.action-panel .section-title { font-size: 36rpx; }
.action-panel .claim-main { font-size: 34rpx; }
.action-panel .claim-sub { font-size: 28rpx; }
.action-panel .admin-tip,
.action-panel .no-permission-tip { font-size: 28rpx; }
.action-panel .form-label { font-size: 38rpx; }
.action-panel .form-label-tip { font-size: 28rpx; }
.action-panel .form-hint { font-size: 28rpx; }
.action-panel .material-tip { font-size: 30rpx; }
.action-panel .form-input,
.action-panel .form-picker,
.action-panel .operator-select { font-size: 40rpx; height: 104rpx; }
.action-panel .select-arrow { font-size: 34rpx; }
.action-panel .form-textarea { font-size: 38rpx; min-height: 160rpx; }
.action-panel .repeat-option { font-size: 36rpx; height: 88rpx; }
.action-panel .primary-btn,
.action-panel .secondary-btn { font-size: 34rpx; }
.action-panel .batch-toggle { font-size: 36rpx; }
.action-panel .batch-form .form-label { font-size: 38rpx; }
.action-panel .batch-form .form-input { font-size: 40rpx; height: 104rpx; }

/* 认领条主文案（当前工序：…）：显眼品牌蓝，与蓝底认领条呼应 */
.action-panel .claim-bar.free .claim-main {
  color: #1d4ed8;
  font-weight: 700;
}
