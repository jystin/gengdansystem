<view class="container page-admin" wx:if="{{currentUser}}">
  <view class="top-left-home" bindtap="goToHome">
    <text class="home-icon">⌂</text>
  </view>
  <view class="hero card">
    <view class="row">
      <view>
        <view class="title">管理中心</view>
        <view class="subtle">{{currentUser.role === 'superadmin' ? '超级管理员可管理权限和删除管理员' : '管理员可审批员工和删除普通员工'}}</view>
      </view>
      <text class="badge badge-info">{{currentUser.role === 'superadmin' ? '超管' : currentUser.role === 'admin' ? '管理' : '员工'}}</text>
    </view>
    <view class="hero-actions">
      <button class="action-btn primary" bindtap="goCreateOrder">新建工单</button>
      <button class="action-btn primary" bindtap="goMaterial">材料库存</button>
      <button class="action-btn primary" bindtap="goScan">扫码页</button>
      <button class="action-btn ghost" bindtap="goProfile">个人中心</button>
      <button class="action-btn ghost" bindtap="goHome">返回首页</button>
    </view>
  </view>

  <view class="metrics">
    <view class="metric card metric-all" bindtap="goOrdersByCategory" data-category="all">
      <view class="metric-left">
        <text class="metric-value">{{dashboard.total || 0}}</text>
        <text class="metric-label">工单总数</text>
      </view>
      <text class="metric-arrow">›</text>
    </view>
    <view class="metric card metric-urgent" bindtap="goOrdersByCategory" data-category="urgent">
      <view class="metric-left">
        <text class="metric-value">{{dashboard.urgent || 0}}</text>
        <text class="metric-label">加急工单</text>
      </view>
      <text class="metric-arrow">›</text>
    </view>
    <view class="metric card metric-overdue" bindtap="goOrdersByCategory" data-category="overdue">
      <view class="metric-left">
        <text class="metric-value">{{dashboard.overdue || 0}}</text>
        <text class="metric-label">逾期工单</text>
      </view>
      <text class="metric-arrow">›</text>
    </view>
    <view class="metric card metric-paused" bindtap="goOrdersByCategory" data-category="paused">
      <view class="metric-left">
        <text class="metric-value">{{dashboard.paused || 0}}</text>
        <text class="metric-label">暂停</text>
      </view>
      <text class="metric-arrow">›</text>
    </view>
    <view class="metric card metric-completed" bindtap="goOrdersByCategory" data-category="completed">
      <view class="metric-left">
        <text class="metric-value">{{dashboard.completed || 0}}</text>
        <text class="metric-label">已完成</text>
      </view>
      <text class="metric-arrow">›</text>
    </view>
    <view class="metric card metric-processing" bindtap="goOrdersByCategory" data-category="processing">
      <view class="metric-left">
        <text class="metric-value">{{dashboard.processing || 0}}</text>
        <text class="metric-label">生产中</text>
      </view>
      <text class="metric-arrow">›</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view>
        <view class="section-title">待审批员工</view>
        <view class="subtle">新员工打开小程序申请加入后，审批前会先进入此处</view>
      </view>
    </view>

    <block wx:if="{{pendingEmployees.length > 0}}">
      <block wx:for="{{pendingEmployees}}" wx:key="id">
        <view class="person-card">
          <view class="row">
            <view>
              <view class="person-name">{{item.name}}</view>
              <view class="subtle">{{item._stationDisplay || '未分配岗位'}} · {{item.note || '无备注'}}</view>
            </view>
            <text class="badge badge-warning">待审批</text>
          </view>
          <view class="card-actions">
            <button class="mini-btn success" data-id="{{item.id}}" bindtap="approveEmployee">通过</button>
            <button class="mini-btn ghost" data-id="{{item.id}}" bindtap="rejectEmployee">驳回</button>
            <button class="mini-btn danger" data-id="{{item.id}}" bindtap="deleteEmployee">删除</button>
          </view>
        </view>
      </block>
    </block>
    <view wx:else class="empty-state">
      <view class="empty-icon">✓</view>
      <view class="empty-text">暂无待审批员工</view>
    </view>
  </view>

  <view class="section card">
    <view class="section-head collapsible-head" bindtap="toggleEmployeePanel">
      <view>
        <view class="section-title">员工权限管理（{{employees.length}}人）</view>
        <view class="subtle">超级管理员可赋权/回收管理员权限，可删除普通员工</view>
      </view>
      <text class="collapse-arrow {{employeePanelOpen ? 'open' : ''}}">›</text>
    </view>

    <view wx:if="{{employeePanelOpen}}" class="collapsible-body">
      <block wx:for="{{employees}}" wx:key="id">
        <view class="person-card">
          <view class="row">
            <view>
              <view class="person-name">{{item.name}}</view>
              <view class="subtle">{{item._stationDisplay || '未分配岗位'}} · {{item.roleLabel || '员工'}} · {{item.statusLabel || '待审批'}}</view>
            </view>
            <text class="badge {{item.status === 'active' ? 'badge-success' : 'badge-warning'}}">{{item.statusLabel || '待审批'}}</text>
          </view>
          <view class="card-actions">
            <button wx:if="{{currentUser.role === 'superadmin' && item.role !== 'superadmin' && item.role !== 'admin'}}" class="mini-btn success" data-id="{{item.id}}" bindtap="promoteToAdmin">设为管理员</button>
            <button wx:if="{{currentUser.role === 'superadmin' && item.role === 'admin'}}" class="mini-btn ghost" data-id="{{item.id}}" bindtap="demoteToWorker">取消管理员</button>
            <button wx:if="{{((currentUser.role === 'admin' && item.role === 'worker') || (currentUser.role === 'superadmin' && item.role !== 'superadmin'))}}" class="mini-btn danger" data-id="{{item.id}}" bindtap="deleteEmployee">删除</button>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="section card">
    <view class="section-head">
      <view>
        <view class="section-title">最近日志</view>
        <view class="subtle">创建工单、审批、删人、改权限都会留下记录</view>
      </view>
    </view>

    <block wx:for="{{logs}}" wx:key="id">
      <view class="log-item">
        <view class="row">
          <text class="log-action">{{item.action}}</text>
          <text class="subtle">{{item.at}}</text>
        </view>
        <view class="subtle">{{item.target}} · {{item.operator}}</view>
      </view>
    </block>
  </view>

  <view wx:if="{{currentUser.role === 'superadmin'}}" class="section card snapshot-section">
    <view class="section-head">
      <view>
        <view class="section-title">🖴 系统镜像点</view>
        <view class="subtle">每 8 小时自动创建，保留最近 10 个。恢复后会自动同步云端数据</view>
      </view>
    </view>

    <view class="snapshot-controls">
      <view class="snapshot-row">
        <picker
          mode="selector"
          range="{{snapshotLabels}}"
          value="{{selectedSnapshotIndex}}"
          bindchange="onSnapshotChange"
          class="snapshot-picker"
        >
          <view class="picker snapshot-select {{selectedSnapshotIndex < 0 ? 'snapshot-placeholder' : ''}}">
            {{selectedSnapshotIndex >= 0 ? snapshotLabels[selectedSnapshotIndex] : '请选择要恢复的镜像点'}}
          </view>
        </picker>
        <text class="snapshot-count">{{snapshots.length}}/10</text>
      </view>

      <view class="snapshot-actions">
        <button
          class="mini-btn ghost snapshot-create-btn"
          bindtap="createSnapshot"
          loading="{{snapshotSaving}}"
          disabled="{{snapshotSaving || snapshotRestoring}}"
        >保存镜像点</button>
        <button
          class="mini-btn danger snapshot-restore-btn"
          bindtap="restoreSnapshot"
          loading="{{snapshotRestoring}}"
          disabled="{{selectedSnapshotIndex < 0 || snapshotSaving || snapshotRestoring}}"
        >恢复到此镜像点</button>
      </view>

      <!-- 进度条 -->
      <view wx:if="{{snapshotProgressVisible}}" class="snapshot-progress-wrap">
        <view class="snapshot-progress-bar">
          <view class="snapshot-progress-fill" style="width: {{snapshotProgressPercent}}%;"></view>
        </view>
        <view class="snapshot-progress-info">
          <text class="snapshot-progress-text">{{snapshotProgressText}}</text>
          <text class="snapshot-progress-pct">{{snapshotProgressPercent}}%</text>
        </view>
      </view>

      <view wx:if="{{snapshots.length === 0}}" class="snapshot-empty">
        <text class="subtle">暂无镜像点，点击"保存镜像点"手动创建</text>
      </view>
    </view>
  </view>
</view>

<view wx:else class="container">
  <view class="card empty-state">
    <view class="title">无权限访问</view>
    <view class="subtle">请切换到管理员或超级管理员账号。</view>
  </view>
</view>
